NODE_ENV=development
PORT=4000

# SQLite database file (relative to backend/) — used only when DATABASE_URL is unset.
DATABASE_PATH=./database.sqlite

# Set this in production (Vercel Postgres / Neon / any Postgres) to switch the
# Sequelize dialect from SQLite to Postgres automatically. Leave unset for local dev.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins (add Vercel preview URLs if needed)
FRONTEND_ORIGIN=http://localhost:4200

# Business rules
VAT_RATE=0.1925
FREE_SHIPPING_THRESHOLD=500000
DEFAULT_SHIPPING_FEE=10000
